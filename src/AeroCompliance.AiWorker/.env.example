# Real-inference profile. Values below match the verified model in models/best.pt.
AI_MODE=yolo
AI_MODEL_PATH=/models/best.pt
# Verified from the checkpoint itself, not from the training notes: the model exposes TWO classes
# (0=building, 1=road). The reference model_info.json/data.yaml claim a third "violation" class
# that the shipped weights do not contain.
AI_MODEL_NAME=yolo26m-seg-aerocompliance
AI_MODEL_VERSION=2026-08-27
AI_CONFIDENCE_THRESHOLD=0.25
# Connection details are supplied by AppHost at runtime; never commit real values.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=false
MINIO_BUCKET=aerocompliance-images
